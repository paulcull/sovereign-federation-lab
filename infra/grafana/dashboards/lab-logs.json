{
  "uid": "sovereign-logs",
  "title": "Sovereign Lab \u00b7 Application Logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "sovereign",
    "lab"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API and worker events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "sovereign-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sovereign-poc-harness\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Server failures and worker retries",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "sovereign-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"sovereign-poc-harness\"} | json | level=~\"ERROR|WARNING\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
